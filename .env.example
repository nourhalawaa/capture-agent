TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Whitelist: the only Telegram user the bot responds to.
# Message @userinfobot on Telegram to get your numeric ID.
TELEGRAM_ALLOWED_USER_ID=your_numeric_telegram_id

# --- Windows (native dev) ---
RAW_FOLDER=C:\path\to\your\wiki\raw

# Hub inbox queue. Defaults to <RAW_FOLDER's parent>\system\inbox.md — override only if your layout differs.
# INBOX_FILE=C:\path\to\your\vault\system\inbox.md

# Execution district (/do, /done, /now). Defaults to <RAW_FOLDER's parent>\execution.
# EXECUTION_FOLDER=C:\path\to\your\vault\execution
#
# The individual files default to EXECUTION_FOLDER\<name>.md and rarely need overriding:
# COMMITMENTS_FILE, ACTIONS_FILE, EXEC_INBOX_FILE, NOW_FILE, DONE_FILE.
# DONE_FILE is the exception — the done-log's current home is TEMPORARY (a tracking
# system is planned), so point this at the new location when that lands.

# Firefox profile path for gallery-dl cookies (burner Instagram account, Windows only)
GALLERY_DL_COOKIES=C:\path\to\Firefox\Profiles\xxxxxxxx.Profile 1

# Override only if Tesseract isn't at the default install path (Windows only)
TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# --- Docker / Linux server (home-server 24/7 deployment) ---
# RAW_FOLDER, INBOX_FILE, EXECUTION_FOLDER and HF_HOME are set via docker-compose.yml's
# environment block (they resolve under /vault inside the container) — do NOT set them here.
#
# VAULT_PATH: absolute path to the server's Syncthing copy of The Hub. The compose
# file bind-mounts this to /vault, so everything the bot writes syncs to laptop+phone.
VAULT_PATH=/home/nour/TheHub
#
# PUID/PGID: your host user's uid/gid (run `id -u` and `id -g`). The container runs
# as this so vault files are owned by you, not root. Defaults to 1000 if unset.
PUID=1000
PGID=1000
#
# Export cookies once from a logged-in Instagram/Facebook browser session, then place
# the Netscape-format file at secrets/cookies.txt (compose mounts it read-only). On the
# Windows dev box you can generate it from the burner Firefox profile:
#
#   .\.venv\Scripts\yt-dlp.exe --cookies-from-browser "firefox:<profile-path>" \
#       --cookies secrets/cookies.txt --skip-download "https://www.instagram.com/"
#
# Re-export when Instagram expires the session (~90 days). An empty file is tolerated
# for YouTube/thought-only testing; IG/FB captures need real cookies.
GALLERY_DL_COOKIES_FILE=
